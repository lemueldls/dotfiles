// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // "disable_ai": true,
  "format_on_save": "on",
  "diff_view_style": "unified",
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-3.5-flash",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "proxy": "",
  "instrumentation": {
    "performance_profiler": {
      "enabled": false,
    },
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
  },
  "file_scan_exclusions": ["**/AGENTS.md"],
  "git_panel": { "tree_view": true, "dock": "left" },
  "project_panel": { "dock": "right" },
  "wrap_guides": [80, 100, 120],
  "terminal": {
    "font_size": 13.0,
    "shell": { "program": "fish" },
    "font_family": "IosevkaTerm Nerd Font",
    "font_fallbacks": [
      "Sarasa Term SC",
      "Sarasa Term J",
      "Sarasa Term K",
      "Symbols Nerd Font",
      "Noto Color Emoji",
    ],
  },
  "tab_size": 2,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 13,
  // "buffer_font_features": {
  //   "calt": false
  // },
  "ui_font_family": "Iosevka Book",
  "ui_font_fallbacks": [
    "Sarasa UI SC",
    "Sarasa UI J",
    "Sarasa UI K",
    "Noto Color Emoji",
    "Symbols Nerd Font",
  ],
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
  },
  "buffer_font_family": "IosevkaCode Nerd Font",
  "buffer_font_fallbacks": [
    "Sarasa Mono SC",
    "Sarasa Mono J",
    "Sarasa Mono K",
    "Noto Color Emoji",
    "Symbols Nerd Font",
  ],
  "languages": {
    "Rust": { "tab_size": 4 },
    "TOML": {
      "formatter": {
        // "language_server": {
        //   "name": "taplo"
        // }
        "external": {
          "command": "taplo",
          "arguments": ["format", "-"],
        },
      },
    },
    "Nix": { "language_servers": ["nixd", "!nil"] },
    "C++": {
      "tab_size": 2,
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    "kotlin-lsp": {
      "binary": {
        "path": "/usr/bin/kotlin-lsp",
        "arguments": ["--stdio"],
      },
    },
  },
}
